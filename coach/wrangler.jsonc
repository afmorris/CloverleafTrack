// Cloverleaf Coach: the interactive coaching tools at coach.cloverleaftrack.com. BRAIN.md [C133].
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloverleaf-coach",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    // Static pages and JS. Paths with no matching file (all of /api/*) fall through to the Worker.
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloverleaf-coach",
      // Replace with the id printed by `wrangler d1 create cloverleaf-coach` before the first deploy.
      // Local dev (`wrangler dev`) does not use it.
      "database_id": "7ec08958-c9ce-4fbb-8419-1c027df010f9",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "coach.cloverleaftrack.com", "custom_domain": true }],
  // Only reachable through the custom domain, where Cloudflare Access signs people in. A workers.dev or preview URL
  // would skip Access entirely, so both stay off.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
  // Secret, not in this file: SNAPSHOT_TOKEN (wrangler secret put SNAPSHOT_TOKEN; locally in .dev.vars).
}
