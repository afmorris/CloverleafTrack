@using CloverleafTrack.ViewModels.Shared
@model HomePageViewModel

@{
    ViewData["Title"] = "Cloverleaf Track & Field";

    var homeBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var homeDescription = CloverleafTrack.Web.Utilities.SeoHelper.Truncate(
        $"Cloverleaf Colts track & field — {Model.ActiveAthletes} active athletes, {Model.TotalPRsThisSeason} PRs and {Model.SchoolRecordsBroken} school records this season. All-time leaderboards, meet results, and career pages.");

    ViewData["Seo"] = new SeoMetadataViewModel
    {
        Description = homeDescription,
        CanonicalPath = "/",
        OgType = "website",
        Breadcrumbs = new List<SeoBreadcrumbViewModel>
        {
            new() { Name = "Home", Path = "/" }
        },
        JsonLdBlocks = new List<string>
        {
            CloverleafTrack.Web.Utilities.SeoHelper.BuildOrganizationJsonLd(homeBaseUrl)
        }
    };
}

<div class="max-w-4xl mx-auto px-4 sm:px-6">

    @* 1. Latest meet header + impact strip *@
    @await Html.PartialAsync("_HomePageLatestMeetImpactCard", Model)

    @* 2. Highlights digest *@
    @await Html.PartialAsync("_HomePageHighlightsDigest", Model)

    @* 3. On This Day (slim line) *@
    @await Html.PartialAsync("_HomePageOnThisDayCard", Model)

    @* 4. Season strip *@
    @await Html.PartialAsync("_HomePageSeasonAtAGlanceCard", Model)

    @* 5. Upcoming meets *@
    @await Html.PartialAsync("_HomePageUpcomingMeets", Model)

</div>
