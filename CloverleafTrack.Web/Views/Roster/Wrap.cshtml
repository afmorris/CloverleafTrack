@using CloverleafTrack.ViewModels.Shared
@using CloverleafTrack.ViewModels.Athletes
@model AthleteWrapViewModel

@{
    ViewBag.Title = $"{Model.FullName} Career Wrap";

    var seoDescription = Model.HasData
        ? CloverleafTrack.Web.Utilities.SeoHelper.Truncate(
            $"{Model.FullName}, Class of {Model.GraduationYear} — career wrap, Cloverleaf Track & Field. {Model.Seasons} season{(Model.Seasons == 1 ? "" : "s")}, {Model.PRs} PRs, {Model.SchoolRecords} school record{(Model.SchoolRecords == 1 ? "" : "s")}.")
        : $"{Model.FullName} career wrap — Cloverleaf Track & Field.";

    ViewData["Seo"] = new SeoMetadataViewModel
    {
        Description = seoDescription,
        Breadcrumbs = new List<SeoBreadcrumbViewModel>
        {
            new() { Name = "Home", Path = "/" },
            new() { Name = "Roster", Path = "/roster" },
            new() { Name = Model.FullName, Path = $"/roster/{Model.Slug}" },
            new() { Name = "Career wrap", Path = Context.Request.Path.Value ?? "/" }
        }
    };

    var card = "bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700";
    var h2 = "text-2xl font-bold mb-4 text-gray-900 dark:text-white";
    var link = "text-blue-600 dark:text-blue-400 hover:underline";
    var span = Model.Seasons == 1 ? Model.FirstSeason : $"{Model.FirstSeason} to {Model.LastSeason}";
}

<div class="max-w-4xl mx-auto px-4 sm:px-6" style="padding-bottom:4rem">

    <!-- Header -->
    <div class="mb-8">
        <a href="/roster/@Model.Slug" class="text-gray-600 dark:text-gray-400 text-sm mb-2 inline-block">← @Model.FullName</a>
        <div class="text-sm font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-1">Career wrap</div>
        <div class="flex flex-wrap items-center gap-4">
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white">@Model.FullName</h1>
            @if (Model.HasData)
            {
                <a href="@Model.PdfUrl"
                   class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white text-sm font-semibold transition-colors">
                    Download the poster (PDF)
                </a>
            }
        </div>
        <p class="mt-2 text-gray-600 dark:text-gray-400">Class of @Model.GraduationYear · @Model.TeamLabel@(Model.HasData ? " · " + span : "")</p>
    </div>

    @if (!Model.HasData)
    {
        <div class="@card p-8 text-gray-600 dark:text-gray-400">No results have been recorded for this athlete yet.</div>
    }
    else
    {
        @if (Model.HasPartialSeasons)
        {
            <div class="@card p-4 mb-8 text-sm text-gray-700 dark:text-gray-300" style="border-left:4px solid #9ca3af">
                Seasons before 2020-21 only have scoring performances recorded, not every result, so early marks and PR counts can be incomplete.
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SummaryHtml))
        {
            <section class="mb-10">
                <div class="@card p-6" style="border-left:4px solid #f59e0b">
                    <h2 class="text-sm font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-400 mb-2">The career in words</h2>
                    <p class="text-gray-800 dark:text-gray-200 leading-relaxed">@Html.Raw(Model.SummaryHtml)</p>
                </div>
            </section>
        }

        <!-- Headline numbers -->
        <section class="mb-12">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @{
                    var tiles = new (string Label, int Value, string Border, string Text)[]
                    {
                        (Model.Seasons == 1 ? "Season" : "Seasons", Model.Seasons, "border-gray-200 dark:border-gray-700", "text-gray-900 dark:text-white"),
                        ("Meets", Model.Meets, "border-blue-200 dark:border-blue-700/30", "text-blue-900 dark:text-blue-100"),
                        ("PRs", Model.PRs, "border-purple-200 dark:border-purple-700/30", "text-purple-900 dark:text-purple-100"),
                        ("School records", Model.SchoolRecords, "border-yellow-200 dark:border-yellow-700/30", "text-yellow-900 dark:text-yellow-100"),
                    };
                }
                @foreach (var t in tiles)
                {
                    <div class="bg-white dark:bg-gray-800 rounded-xl p-6 border @t.Border">
                        <div class="text-sm mb-2 font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400">@t.Label</div>
                        <div class="text-4xl font-bold @t.Text">@t.Value</div>
                    </div>
                }
            </div>
            <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
                @Model.Results marks recorded, @Model.TopTenEvents event@(Model.TopTenEvents == 1 ? "" : "s") with a best mark in the all-time top 10. PRs count marks that beat an earlier mark; a first mark in an event is not a PR.
            </p>
        </section>

        <!-- Biggest improvements -->
        @if (Model.Improvements.Any())
        {
            <section class="mb-12">
                <h2 class="@h2">Biggest improvements</h2>
                <div class="@card overflow-hidden">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 dark:bg-gray-700/50 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                                <th class="px-4 py-2 text-left font-medium">Event</th>
                                <th class="px-4 py-2 text-left font-medium">First</th>
                                <th class="px-4 py-2 text-left font-medium">Best</th>
                                <th class="px-4 py-2 text-left font-medium">Change</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                            @foreach (var i in Model.Improvements)
                            {
                                <tr>
                                    <td class="px-4 py-2.5 text-gray-900 dark:text-white">@i.EventLabel <span class="text-xs text-gray-500 dark:text-gray-400">(@i.Performances marks)</span></td>
                                    <td class="px-4 py-2.5 mark text-gray-700 dark:text-gray-300">@i.First</td>
                                    <td class="px-4 py-2.5 mark font-bold text-gray-900 dark:text-gray-100">@i.Best</td>
                                    <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300">@i.Change</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <!-- Career bests -->
        @if (Model.Bests.Any())
        {
            <section class="mb-12">
                <h2 class="@h2">Career bests</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">Highest percentile first.</p>
                <div class="@card overflow-hidden">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="bg-gray-50 dark:bg-gray-700/50 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                                <th class="px-4 py-2 text-left font-medium">Event</th>
                                <th class="px-4 py-2 text-left font-medium">Mark</th>
                                <th class="px-4 py-2 text-left font-medium">Percentile</th>
                                <th class="px-4 py-2 text-left font-medium hidden sm:table-cell">Meet</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                            @foreach (var b in Model.Bests)
                            {
                                <tr>
                                    <td class="px-4 py-2.5 text-gray-900 dark:text-white">@b.EventLabel@(b.IsRelay ? " (relay)" : "")</td>
                                    <td class="px-4 py-2.5">
                                        <span class="mark font-bold text-gray-900 dark:text-gray-100">@b.Mark</span>
                                        @if (b.IsSchoolRecord) { <span class="text-xs font-semibold text-yellow-700 dark:text-yellow-400">SR</span> }
                                        else if (b.AllTimeRank is <= 10) { <span class="text-xs text-gray-500 dark:text-gray-400">#@b.AllTimeRank all-time</span> }
                                    </td>
                                    <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300">@(b.Percentile?.ToString() ?? "-")</td>
                                    <td class="px-4 py-2.5 hidden sm:table-cell text-gray-600 dark:text-gray-400">@b.MeetName, @b.Date.ToString("MMM d, yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <!-- Season by season -->
        <section class="mb-12">
            <h2 class="@h2">Season by season</h2>
            <div class="@card overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-700/50 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                            <th class="px-4 py-2 text-left font-medium">Season</th>
                            <th class="px-4 py-2 text-left font-medium">Class</th>
                            <th class="px-4 py-2 text-right font-medium">Events</th>
                            <th class="px-4 py-2 text-right font-medium">Marks</th>
                            <th class="px-4 py-2 text-right font-medium">PRs</th>
                            <th class="px-4 py-2 text-right font-medium">SRs</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var s in Model.SeasonRows)
                        {
                            <tr>
                                <td class="px-4 py-2.5 text-gray-900 dark:text-white">@s.Name</td>
                                <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300">@s.Class</td>
                                <td class="px-4 py-2.5 text-right text-gray-700 dark:text-gray-300">@s.Events</td>
                                <td class="px-4 py-2.5 text-right text-gray-700 dark:text-gray-300">@s.Results</td>
                                <td class="px-4 py-2.5 text-right text-gray-700 dark:text-gray-300">@s.PRs</td>
                                <td class="px-4 py-2.5 text-right text-gray-700 dark:text-gray-300">@s.SchoolRecords</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @await Html.PartialAsync("_CareerProgressionSection", Model.CareerCharts)

        <p class="text-sm"><a href="/roster/@Model.Slug" class="@link">Full results for @Model.FullName →</a></p>
    }
</div>
