@using CloverleafTrack.ViewModels.Shared
@model PerformanceAttemptSeriesViewModel

@*
    Athlete page (Views/Roster/Details.cshtml) and Event page (Views/Leaderboard/Details.cshtml) wrapper around the attempt
    strip. It used to add a "Show attempt chart" disclosure with an inline-SVG bar chart; that was removed (BRAIN.md [C70])
    because the strip already shows every attempt. The partial is kept so both pages keep one call site.
*@
@if (Model.HasAttempts)
{
    @await Html.PartialAsync("_AttemptStrip", Model)
}
