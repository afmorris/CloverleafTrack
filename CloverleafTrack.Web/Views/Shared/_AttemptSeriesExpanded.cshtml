@using CloverleafTrack.ViewModels.Shared
@model PerformanceAttemptSeriesViewModel

@*
    Strip + a native <details>/<summary> disclosure holding a simple inline-SVG bar chart
    of the attempt series. No JavaScript required for the disclosure — keyboard-accessible
    for free. Never expanded by default. Used on the Athlete page (Views/Roster/Details.cshtml)
    and the Event page (Views/Leaderboard/Details.cshtml).

    IMPORTANT: The Meet recap page (Views/Meets/Details.cshtml) intentionally does NOT use
    this partial — it uses _AttemptStrip.cshtml directly so no <details> markup exists in the
    DOM there at all, even collapsed. See BRAIN.md for why (too many throwers per meet for a
    disclosure-per-row to be worth the noise). Do not "fix" that by swapping this partial in.
*@
@if (Model.HasAttempts)
{
    @await Html.PartialAsync("_AttemptStrip", Model)

    @{
        var validAttempts = Model.Attempts.Where(a => a.IsValid).ToList();
        var maxValid = validAttempts.Count > 0 ? validAttempts.Max(a => a.DistanceInches!.Value) : 0;
        var chartScaleMax = maxValid > 0 ? maxValid * 1.15 : 1;

        const int chartWidth = 220;
        const int chartHeight = 70;
        const int labelHeight = 14;
        const int barGap = 5;
        var barCount = Model.Attempts.Count;
        var barWidth = barCount > 0 ? (double)(chartWidth - barGap * (barCount - 1)) / barCount : chartWidth;
    }

    <details class="mt-1">
        <summary class="text-[11px] text-gray-400 dark:text-gray-500 cursor-pointer hover:text-gray-600 dark:hover:text-gray-300 select-none">Show attempt chart</summary>
        <div class="mt-2">
            <svg width="@chartWidth" height="@(chartHeight + labelHeight)" viewBox="0 0 @chartWidth @(chartHeight + labelHeight)"
                 role="img" aria-label="Attempt series bar chart">
                @for (var i = 0; i < Model.Attempts.Count; i++)
                {
                    var attempt = Model.Attempts[i];
                    var x = i * (barWidth + barGap);
                    var isValid = attempt.IsValid;
                    var barHeight = isValid ? Math.Max(2.0, attempt.DistanceInches!.Value / chartScaleMax * chartHeight) : 3.0;
                    var y = chartHeight - barHeight;
                    var fill = attempt.IsFoul ? "#d1d5db" : attempt.IsPass ? "#e5e7eb" : (attempt.IsBest ? "#f59e0b" : "#60a5fa");

                    <rect x="@x.ToString("0.##")" y="@y.ToString("0.##")" width="@barWidth.ToString("0.##")" height="@barHeight.ToString("0.##")" fill="@fill" rx="2"></rect>
                    <text x="@((x + barWidth / 2).ToString("0.##"))" y="@(chartHeight + 11)" font-size="9" text-anchor="middle" fill="currentColor" class="text-gray-500 dark:text-gray-400">@attempt.AttemptNumber</text>
                }
            </svg>
        </div>
    </details>
}
