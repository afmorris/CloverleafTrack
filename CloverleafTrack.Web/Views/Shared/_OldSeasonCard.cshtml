@using CloverleafTrack.ViewModels.Seasons;

@model SeasonCardViewModel

<div class="flex items-center justify-between gap-3 p-4 bg-gray-100 dark:bg-gray-800 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-900 transition-colors">
    <a asp-controller="Seasons" asp-action="Details" asp-route-name="@Model.Name" class="block flex-1">
        <div class="font-medium mb-1 text-gray-900 dark:text-white">@Model.Name</div>
        <div class="text-sm text-gray-600 dark:text-gray-400">
            @Model.TotalMeets meets • @Model.IndoorSchoolRecordCount Indoor SRs • @Model.OutdoorSchoolRecordCount Outdoor SRs
        </div>
    </a>
    @if (Model.HasWrap)
    {
        <a href="/seasons/@Model.Name/wrap" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline whitespace-nowrap">Season wrap →</a>
    }
</div>
