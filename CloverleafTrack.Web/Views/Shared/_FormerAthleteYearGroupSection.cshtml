@using CloverleafTrack.ViewModels.Shared
@model KeyValuePair<int, List<AthleteViewModel>>

<details class="mb-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
    <summary class="px-4 py-3 cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors flex items-center justify-between select-none list-none">
        <div class="flex items-center gap-3">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white">Class of @Model.Key</h3>
            <span class="text-xs text-gray-500 dark:text-gray-400">@Model.Value.Count athletes</span>
        </div>
        <svg class="details-arrow w-4 h-4 text-gray-400 dark:text-gray-500 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </summary>

    <div class="border-t border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
        @{
            var boysAthletes = Model.Value.Where(a => a.Gender == CloverleafTrack.Models.Enums.Gender.Male).ToList();
            var girlsAthletes = Model.Value.Where(a => a.Gender == CloverleafTrack.Models.Enums.Gender.Female).ToList();
        }
        @foreach (var (genderAthletes, gender) in new[] {
            (boysAthletes, CloverleafTrack.Models.Enums.Gender.Male),
            (girlsAthletes, CloverleafTrack.Models.Enums.Gender.Female)
        })
        {
            if (genderAthletes.Any())
            {
                <div class="px-4 pt-3">
                    @await Html.PartialAsync("_GenderSectionHeader", new GenderSectionHeaderViewModel { Gender = gender, Count = genderAthletes.Count, Size = "sm" })
                </div>
                <table class="w-full text-sm" data-sortable>
                    <thead class="bg-gray-50 dark:bg-gray-700/50 text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400">
                        <tr>
                            <th class="px-4 py-2 text-left font-medium" data-sort-col="name" data-sort-type="str" data-sort-dir="asc">Name</th>
                            <th class="px-4 py-2 text-left font-medium hidden md:table-cell" data-sort-col="event" data-sort-type="str" data-sort-dir="asc">Top Event</th>
                            <th class="px-4 py-2 text-right font-medium">Best Mark</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        @foreach (var athlete in genderAthletes)
                        {
                            var topEvent = athlete.EventsInCategory.FirstOrDefault();
                            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                                <td class="px-4 py-2.5" data-sort="@athlete.FullName">
                                    <a asp-controller="Roster" asp-action="Details" asp-route-slug="@athlete.AthleteSlug"
                                       class="font-medium text-gray-900 dark:text-white hover:underline">
                                        @athlete.FullName
                                    </a>
                                </td>
                                <td class="px-4 py-2.5 text-gray-600 dark:text-gray-400 truncate max-w-[160px] hidden md:table-cell" data-sort="@(topEvent?.Name ?? "")">@(topEvent?.Name ?? "")</td>
                                <td class="px-4 py-2.5 text-right">
                                    @if (topEvent != null)
                                    {
                                        <span class="mark font-semibold text-gray-900 dark:text-white">@topEvent.PersonalRecord</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</details>
