@using CloverleafTrack.Models
@using Slugify
@using CloverleafTrack.Models.Enums
@using CloverleafTrack.ViewModels.Shared
@model MeetDetailsViewModel

@{
    ViewBag.Title = Model.Name;
    var typeBadge = Model.MeetType switch
    {
        MeetType.Dual => "Dual",
        MeetType.DoubleDual => "Double Dual",
        MeetType.Invitational => "Invitational",
        _ => ""
    };

    var meetLocationPart = string.IsNullOrWhiteSpace(Model.LocationName) ? "" : $", {Model.LocationName}";
    var meetDescription = CloverleafTrack.Web.Utilities.SeoHelper.Truncate(
        $"{Model.Name} — {Model.Date:MMM d, yyyy}{meetLocationPart}. {Model.TotalPerformances} performance{(Model.TotalPerformances == 1 ? "" : "s")}, {Model.TotalPRs} PR{(Model.TotalPRs == 1 ? "" : "s")}, {Model.TotalSchoolRecords} school record{(Model.TotalSchoolRecords == 1 ? "" : "s")}.");

    if (!string.IsNullOrWhiteSpace(Model.SummaryText))
    {
        meetDescription = CloverleafTrack.Web.Utilities.SeoHelper.Truncate(Model.SummaryText);
    }

    var meetPath = Context.Request.Path.Value ?? "/meets";

    ViewData["Seo"] = new SeoMetadataViewModel
    {
        Description = meetDescription,
        OgType = "article",
        Breadcrumbs = new List<SeoBreadcrumbViewModel>
        {
            new() { Name = "Home", Path = "/" },
            new() { Name = "Meets", Path = "/meets" },
            new() { Name = Model.Name, Path = meetPath }
        },
        JsonLdBlocks = new List<string>
        {
            CloverleafTrack.Web.Utilities.SeoHelper.BuildSportsEventJsonLd(
                Model.Name, Model.Date, SeoUrls.PageUrl(meetPath), Model.LocationName, Model.LocationCity, Model.LocationState)
        }
    };
}

@functions {
    bool IsRelay(string athleteName) => athleteName?.Contains("|~|") ?? false;

    string[] GetRelayAthletes(string athleteName) =>
        athleteName?.Split("|~|") ?? Array.Empty<string>();

    string GetCategoryName(CloverleafTrack.Models.Enums.EventCategory category) => category switch
    {
        CloverleafTrack.Models.Enums.EventCategory.Sprints  => "Sprints",
        CloverleafTrack.Models.Enums.EventCategory.Distance => "Distance",
        CloverleafTrack.Models.Enums.EventCategory.Throws   => "Throws",
        CloverleafTrack.Models.Enums.EventCategory.Jumps    => "Jumps",
        CloverleafTrack.Models.Enums.EventCategory.Relays   => "Relays",
        CloverleafTrack.Models.Enums.EventCategory.Hurdles  => "Hurdles",
        _ => "Other"
    };

    string AthleteSlug(string name)
    {
        var parts = name?.Split(' ');
        if (parts?.Length >= 2)
        {
            var helper = new SlugHelper();
            return helper.GenerateSlug($"{parts[0]}-{parts[1]}");
        }
        return string.Empty;
    }
}

<div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Header -->
    <div class="mb-6">
        <a asp-controller="Meets" asp-action="Index" class="text-sm text-gray-500 dark:text-gray-400 hover:underline mb-3 inline-block">
            ← Meets
        </a>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">@Model.Name</h1>

        <div class="flex flex-wrap gap-x-3 gap-y-1.5 text-sm text-gray-500 dark:text-gray-400 mt-2 items-center">
            <span>@Model.Date.ToString("MMMM d, yyyy")</span>
            <span>@Model.SeasonName season</span>
            @{
                var loc = string.Join(", ", new[] { Model.LocationName, Model.LocationCity, Model.LocationState }.Where(s => !string.IsNullOrEmpty(s)));
            }
            @if (!string.IsNullOrEmpty(loc)) { <span>@loc</span> }
            <span class="chip-place">@(Model.Environment == CloverleafTrack.Models.Enums.Environment.Indoor ? "Indoor" : "Outdoor")</span>
            @if (!string.IsNullOrEmpty(typeBadge)) { <span class="chip-rank">@typeBadge</span> }
            @if (Model.HandTimed) { <span class="chip-rank">Hand-timed</span> }
        </div>
        @if (Model.TeamResult != null)
        {
            <div class="mt-2">
                @await Html.PartialAsync("_TeamResultBadge", Model.TeamResult)
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SummaryHtml))
    {
        <div class="mb-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 px-5 py-4">
            <p class="text-base leading-relaxed text-gray-700 dark:text-gray-300">@Html.Raw(Model.SummaryHtml)</p>
        </div>
    }

    <!-- Impact strip -->
    <div class="mb-8">
        <div class="metric-strip">
            <div class="metric-cell">
                <span class="metric-value">@Model.TotalPerformances</span>
                <span class="metric-label">Performances</span>
            </div>
            <div class="metric-cell">
                <span class="metric-value text-pr">@Model.TotalPRs</span>
                <span class="metric-label">PRs</span>
            </div>
            <div class="metric-cell">
                <span class="metric-value text-sr">@Model.TotalSchoolRecords</span>
                <span class="metric-label">Records</span>
            </div>
            <div class="metric-cell">
                <span class="metric-value">@Model.TopTenAllTimeCount</span>
                <span class="metric-label">Top-10</span>
            </div>
        </div>
        @if (Model.MeetScore != null)
        {
            var ms = Model.MeetScore;
            <div class="metric-strip mt-2">
                <div class="metric-cell meetscore-cell">
                    <span class="metric-value" style="color:@ms.AccentColor">@ms.Score.ToString("0")@(ms.IsPartial ? "*" : "")</span>
                    <button type="button" class="metric-label meetscore-info-btn" aria-haspopup="dialog" onclick="document.getElementById('meetscore-info').showModal()">MeetScore <span aria-hidden="true">ⓘ</span><span class="sr-only">— how it works</span></button>
                </div>
                @foreach (var (label, tip, value) in new[] { ("Peak", "Top 5 marks, as percentiles", ms.Peak), ("Depth", "Top 40 athlete-event bests, as percentiles", ms.Depth), ("Improvement", ms.PRs + " PRs vs. " + ms.ExpectedPRs.ToString("0.0") + " expected", ms.Improvement) })
                {
                    <div class="metric-cell" title="@tip">
                        <span class="metric-value @(value.HasValue ? "" : "opacity-40")">@(value.HasValue ? value.Value.ToString("0") : "—")</span>
                        <div class="pct-bar-track" style="width:80%;margin:.4rem 0 .3rem">
                            @if (value.HasValue)
                            {
                                var pct = (int)Math.Round(Math.Clamp(value.Value, 0, 100));
                                <div class="pct-bar-fill" style="width:@(pct)%;background-color:@PercentileHelper.GetFillColor(pct)"></div>
                                <div class="pct-bar-median-tick"></div>
                            }
                        </div>
                        <span class="metric-label">@label</span>
                    </div>
                }
            </div>
            @if (ms.IsPartial)
            {
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-2"><span class="font-semibold">* @ms.BasisLabel.</span> @ms.BasisExplanation</p>
            }
            <dialog id="meetscore-info" class="meetscore-dialog" aria-labelledby="meetscore-info-title" onclick="if (event.target === this) this.close()">
                <div class="meetscore-dialog-head">
                    <h2 id="meetscore-info-title">About MeetScore</h2>
                    <button type="button" class="meetscore-dialog-close" aria-label="Close" onclick="this.closest('dialog').close()">&times;</button>
                </div>
                <div class="meetscore-dialog-body">
                    <p>MeetScore rates how strong a meet was for Cloverleaf on a 0&ndash;100 scale. It is calculated from the performances recorded at the meet, so it updates whenever results change.</p>
                    <h3>Peak <span>45%</span></h3>
                    <p>The average percentile of the five best marks at the meet. A percentile compares a mark with every mark ever recorded in that event &mdash; 90 means better than 90% of them.</p>
                    <h3>Depth <span>25%</span></h3>
                    <p>The average percentile of the top 40 athlete-event bests, so a meet with strong marks across the whole team scores higher than one carried by a few athletes. A relay counts once.</p>
                    <h3>Improvement <span>30%</span></h3>
                    <p>How many athletes set personal records compared with how many would be expected, given how many meets they had already run. 50 means about as many PRs as expected; higher means more. Individual events only.</p>
                    <h3>The math</h3>
                    <div class="meetscore-math">
                        <div class="meetscore-math-line"><b>Score</b> = 0.45 &times; Peak + 0.25 &times; Depth + 0.30 &times; Improvement</div>
                        <div class="meetscore-math-line"><b>Peak</b> = average percentile of the 5 best marks</div>
                        <div class="meetscore-math-line"><b>Depth</b> = average percentile of the 40 best athlete-event bests (all of them if fewer than 40)</div>
                        <div class="meetscore-math-line"><b>Improvement</b> = 50 + 100 &times; (PRs &minus; Expected PRs) &divide; (Eligible + 10), kept between 0 and 100</div>
                    </div>
                    <p>Expected PRs is the sum, over every athlete-event with prior history, of how often athletes with that many earlier meets historically set a PR. A PR means the meet&rsquo;s best mark beat every mark from earlier-dated meets.</p>
                    <p class="meetscore-math-title">This meet</p>
                    <div class="meetscore-math">
                        @if (ms.Basis == MeetScoreBasis.Full)
                        {
                            <div class="meetscore-math-line">Improvement = 50 + 100 &times; (@ms.PRs &minus; @ms.ExpectedPRs.ToString("0.00")) &divide; (@ms.EligibleAthleteEvents + 10) = @ms.Improvement!.Value.ToString("0.0")</div>
                            <div class="meetscore-math-line">Score = 0.45 &times; @ms.Peak!.Value.ToString("0.0") + 0.25 &times; @ms.Depth!.Value.ToString("0.0") + 0.30 &times; @ms.Improvement!.Value.ToString("0.0") = <b>@ms.Score.ToString("0.0")</b></div>
                        }
                        else if (ms.Basis == MeetScoreBasis.PeakOnly)
                        {
                            <div class="meetscore-math-line">Score = Peak = <b>@ms.Score.ToString("0.0")</b> (no weighting; only Peak is available for this era)</div>
                        }
                        else
                        {
                            <div class="meetscore-math-line">Improvement = 50 + 100 &times; (@ms.PRs &minus; @ms.ExpectedPRs.ToString("0.00")) &divide; (@ms.EligibleAthleteEvents + 10) = @ms.Improvement!.Value.ToString("0.0")</div>
                            <div class="meetscore-math-line">Score = Improvement = <b>@ms.Score.ToString("0.0")</b> (JV meets use no weighting)</div>
                        }
                    </div>
                    <h3>Reading the score</h3>
                    <p>Scores are only comparable between meets scored the same way. A <b>*</b> marks a partial score: meets before the 2020&ndash;21 season only have scoring performances recorded (Peak only), and JV meets are scored on Improvement only because percentiles compare against varsity marks. Meets with too few results to score fairly show no MeetScore.</p>
                </div>
            </dialog>
        }
    </div>

    <!-- Results by gender -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- Boys -->
        <div>
            <h2 class="text-lg font-bold mb-4 text-blue-600 dark:text-blue-400">Boys</h2>
            @if (Model.BoysEvents.Any())
            {
                @foreach (var catGroup in Model.BoysEvents.GroupBy(e => e.EventCategory))
                {
                    <div class="mb-6">
                        <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">@GetCategoryName(catGroup.Key)</h3>
                        @foreach (var eventGroup in catGroup)
                        {
                            <details open class="mb-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                                <summary class="px-4 py-2.5 bg-blue-50 dark:bg-blue-900/10 border-b border-blue-100 dark:border-blue-900/20 cursor-pointer list-none flex items-center justify-between select-none hover:bg-blue-100 dark:hover:bg-blue-900/20 transition-colors">
                                    <span class="font-medium text-blue-900 dark:text-blue-300 text-sm">@eventGroup.EventName</span>
                                    <svg class="details-arrow w-4 h-4 text-blue-400 dark:text-blue-600 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                </summary>
                                <table class="w-full text-sm" data-sortable>
                                    <thead class="text-[10px] uppercase tracking-wide text-gray-400 dark:text-gray-500">
                                        <tr>
                                            <th class="px-2 sm:px-4 py-1 text-left font-medium" data-sort-col="athlete" data-sort-type="str" data-sort-dir="asc">Athlete</th>
                                            <th class="px-2 sm:px-4 py-1 text-right font-medium" data-sort-col="mark" data-sort-type="num" data-sort-dir="@(eventGroup.IsFieldEvent ? "desc" : "asc")">Mark</th>
                                            <th class="px-2 sm:px-4 py-1 text-right font-medium">Result</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                                        @foreach (var perf in eventGroup.Performances)
                                        {
                                            var rowClass = perf.IsSchoolRecord ? "row-sr" : (perf.IsPersonalBest ? "row-pr" : "");
                                            <tr class="@rowClass hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                                <td class="px-2 sm:px-4 py-2 align-middle" data-sort="@perf.AthleteName">
                                                    @if (IsRelay(perf.AthleteName))
                                                    {
                                                        <div class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">
                                                            @{
                                                                var members = GetRelayAthletes(perf.AthleteName);
                                                                for (int ri = 0; ri < members.Length; ri++)
                                                                {
                                                                    var a = members[ri];
                                                                    var slug = AthleteSlug(a);
                                                                    if (!string.IsNullOrEmpty(slug))
                                                                    {
                                                                        <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug" class="hover:underline">@a</a>
                                                                    }
                                                                    else { @a }
                                                                    if (ri < members.Length - 1) { <span> / </span> }
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var slug = AthleteSlug(perf.AthleteName);
                                                        if (!string.IsNullOrEmpty(slug))
                                                        {
                                                            <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug"
                                                               class="text-gray-900 dark:text-white hover:underline">@perf.AthleteName</a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-gray-900 dark:text-white">@perf.AthleteName</span>
                                                        }
                                                    }
                                                    @await Html.PartialAsync("_AttemptStrip", perf.AttemptSeries)
                                                    @await Html.PartialAsync("_RoundStrip", perf.RoundSeries, new ViewDataDictionary(ViewData) { { "Left", true } })
                                                </td>
                                                <td class="px-2 sm:px-4 py-2 text-right whitespace-nowrap align-middle" data-sort="@(perf.RawValue?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                                    <span class="mark font-semibold @(perf.IsSchoolRecord ? "text-sr" : (perf.IsPersonalBest ? "text-pr" : "text-gray-900 dark:text-white"))">@perf.Performance</span>
                                                </td>
                                                <td class="px-2 sm:px-4 py-2 text-right align-middle">
                                                    <div class="flex items-center justify-end gap-1 flex-wrap">
                                                        @if (perf.IsSchoolRecord) { <span class="chip-sr" title="School Record">SR</span> }
                                                        @if (perf.IsPersonalBest) { <span class="chip-pr" title="Personal Best">PR</span> }
                                                        @if (perf.IsSeasonBest && !perf.IsPersonalBest) { <span class="chip-rank" title="Season Best">SB</span> }
                                                        @if (perf.AllTimeRank.HasValue && perf.AllTimeRank <= 10)
                                                        {
                                                            <span class="chip-rank" title="All-Time Top 10">#@perf.AllTimeRank</span>
                                                        }
                                                        @foreach (var placing in perf.Placings)
                                                        {
                                                            <span class="chip-place" title="@(placing.OpponentSchoolName != null ? $"vs. {placing.OpponentSchoolName}" : "Place")">
                                                                @placing.PlaceLabel@(placing.OpponentSchoolName != null ? $" vs. {placing.OpponentSchoolName}" : "")
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </details>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-gray-500 dark:text-gray-400">No boys results for this meet.</p>
            }
        </div>

        <!-- Girls -->
        <div>
            <h2 class="text-lg font-bold mb-4 text-pink-600 dark:text-pink-400">Girls</h2>
            @if (Model.GirlsEvents.Any())
            {
                @foreach (var catGroup in Model.GirlsEvents.GroupBy(e => e.EventCategory))
                {
                    <div class="mb-6">
                        <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">@GetCategoryName(catGroup.Key)</h3>
                        @foreach (var eventGroup in catGroup)
                        {
                            <details open class="mb-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                                <summary class="px-4 py-2.5 bg-pink-50 dark:bg-pink-900/10 border-b border-pink-100 dark:border-pink-900/20 cursor-pointer list-none flex items-center justify-between select-none hover:bg-pink-100 dark:hover:bg-pink-900/20 transition-colors">
                                    <span class="font-medium text-pink-900 dark:text-pink-300 text-sm">@eventGroup.EventName</span>
                                    <svg class="details-arrow w-4 h-4 text-pink-400 dark:text-pink-600 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                </summary>
                                <table class="w-full text-sm" data-sortable>
                                    <thead class="text-[10px] uppercase tracking-wide text-gray-400 dark:text-gray-500">
                                        <tr>
                                            <th class="px-2 sm:px-4 py-1 text-left font-medium" data-sort-col="athlete" data-sort-type="str" data-sort-dir="asc">Athlete</th>
                                            <th class="px-2 sm:px-4 py-1 text-right font-medium" data-sort-col="mark" data-sort-type="num" data-sort-dir="@(eventGroup.IsFieldEvent ? "desc" : "asc")">Mark</th>
                                            <th class="px-2 sm:px-4 py-1 text-right font-medium">Result</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                                        @foreach (var perf in eventGroup.Performances)
                                        {
                                            var rowClass = perf.IsSchoolRecord ? "row-sr" : (perf.IsPersonalBest ? "row-pr" : "");
                                            <tr class="@rowClass hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                                <td class="px-2 sm:px-4 py-2 align-middle" data-sort="@perf.AthleteName">
                                                    @if (IsRelay(perf.AthleteName))
                                                    {
                                                        <div class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">
                                                            @{
                                                                var members = GetRelayAthletes(perf.AthleteName);
                                                                for (int ri = 0; ri < members.Length; ri++)
                                                                {
                                                                    var a = members[ri];
                                                                    var slug = AthleteSlug(a);
                                                                    if (!string.IsNullOrEmpty(slug))
                                                                    {
                                                                        <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug" class="hover:underline">@a</a>
                                                                    }
                                                                    else { @a }
                                                                    if (ri < members.Length - 1) { <span> / </span> }
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        var slug = AthleteSlug(perf.AthleteName);
                                                        if (!string.IsNullOrEmpty(slug))
                                                        {
                                                            <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug"
                                                               class="text-gray-900 dark:text-white hover:underline">@perf.AthleteName</a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-gray-900 dark:text-white">@perf.AthleteName</span>
                                                        }
                                                    }
                                                    @await Html.PartialAsync("_AttemptStrip", perf.AttemptSeries)
                                                    @await Html.PartialAsync("_RoundStrip", perf.RoundSeries, new ViewDataDictionary(ViewData) { { "Left", true } })
                                                </td>
                                                <td class="px-2 sm:px-4 py-2 text-right whitespace-nowrap align-middle" data-sort="@(perf.RawValue?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                                    <span class="mark font-semibold @(perf.IsSchoolRecord ? "text-sr" : (perf.IsPersonalBest ? "text-pr" : "text-gray-900 dark:text-white"))">@perf.Performance</span>
                                                </td>
                                                <td class="px-2 sm:px-4 py-2 text-right align-middle">
                                                    <div class="flex items-center justify-end gap-1 flex-wrap">
                                                        @if (perf.IsSchoolRecord) { <span class="chip-sr" title="School Record">SR</span> }
                                                        @if (perf.IsPersonalBest) { <span class="chip-pr" title="Personal Best">PR</span> }
                                                        @if (perf.IsSeasonBest && !perf.IsPersonalBest) { <span class="chip-rank" title="Season Best">SB</span> }
                                                        @if (perf.AllTimeRank.HasValue && perf.AllTimeRank <= 10)
                                                        {
                                                            <span class="chip-rank" title="All-Time Top 10">#@perf.AllTimeRank</span>
                                                        }
                                                        @foreach (var placing in perf.Placings)
                                                        {
                                                            <span class="chip-place" title="@(placing.OpponentSchoolName != null ? $"vs. {placing.OpponentSchoolName}" : "Place")">
                                                                @placing.PlaceLabel@(placing.OpponentSchoolName != null ? $" vs. {placing.OpponentSchoolName}" : "")
                                                            </span>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </details>
                        }
                    </div>
                }
            }
            else
            {
                <p class="text-sm text-gray-500 dark:text-gray-400">No girls results for this meet.</p>
            }
        </div>
    </div>

    @if (Model.MixedEvents.Any())
    {
        <div class="mt-8">
            <h2 class="text-lg font-bold mb-4 text-purple-600 dark:text-purple-400">Mixed relays</h2>
            @foreach (var catGroup in Model.MixedEvents.GroupBy(e => e.EventCategory))
            {
                <div class="mb-6">
                    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2">@GetCategoryName(catGroup.Key)</h3>
                    @foreach (var eventGroup in catGroup)
                    {
                        <details open class="mb-2 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
                            <summary class="px-4 py-2.5 bg-purple-50 dark:bg-purple-900/10 border-b border-purple-100 dark:border-purple-900/20 cursor-pointer list-none flex items-center justify-between select-none hover:bg-purple-100 dark:hover:bg-purple-900/20 transition-colors">
                                <span class="font-medium text-purple-900 dark:text-purple-300 text-sm">@eventGroup.EventName</span>
                                <svg class="details-arrow w-4 h-4 text-purple-400 dark:text-purple-600 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </summary>
                            <table class="w-full text-sm" data-sortable>
                                <thead class="text-[10px] uppercase tracking-wide text-gray-400 dark:text-gray-500">
                                    <tr>
                                        <th class="px-2 sm:px-4 py-1 text-left font-medium" data-sort-col="athlete" data-sort-type="str" data-sort-dir="asc">Athlete</th>
                                        <th class="px-2 sm:px-4 py-1 text-right font-medium" data-sort-col="mark" data-sort-type="num" data-sort-dir="@(eventGroup.IsFieldEvent ? "desc" : "asc")">Mark</th>
                                        <th class="px-2 sm:px-4 py-1 text-right font-medium">Result</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                                    @foreach (var perf in eventGroup.Performances)
                                    {
                                        var rowClass = perf.IsSchoolRecord ? "row-sr" : (perf.IsPersonalBest ? "row-pr" : "");
                                        <tr class="@rowClass hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
                                            <td class="px-2 sm:px-4 py-2 align-middle" data-sort="@perf.AthleteName">
                                                @if (IsRelay(perf.AthleteName))
                                                {
                                                    <div class="text-xs text-gray-700 dark:text-gray-300 leading-relaxed">
                                                        @{
                                                            var members = GetRelayAthletes(perf.AthleteName);
                                                            for (int ri = 0; ri < members.Length; ri++)
                                                            {
                                                                var a = members[ri];
                                                                var slug = AthleteSlug(a);
                                                                if (!string.IsNullOrEmpty(slug))
                                                                {
                                                                    <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug" class="hover:underline">@a</a>
                                                                }
                                                                else { @a }
                                                                if (ri < members.Length - 1) { <span> / </span> }
                                                            }
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    var slug = AthleteSlug(perf.AthleteName);
                                                    if (!string.IsNullOrEmpty(slug))
                                                    {
                                                        <a asp-controller="Roster" asp-action="Details" asp-route-slug="@slug"
                                                           class="text-gray-900 dark:text-white hover:underline">@perf.AthleteName</a>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-gray-900 dark:text-white">@perf.AthleteName</span>
                                                    }
                                                }
                                                @await Html.PartialAsync("_AttemptStrip", perf.AttemptSeries)
                                                @await Html.PartialAsync("_RoundStrip", perf.RoundSeries, new ViewDataDictionary(ViewData) { { "Left", true } })
                                            </td>
                                            <td class="px-2 sm:px-4 py-2 text-right whitespace-nowrap align-middle" data-sort="@(perf.RawValue?.ToString("F6", System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                                <span class="mark font-semibold @(perf.IsSchoolRecord ? "text-sr" : (perf.IsPersonalBest ? "text-pr" : "text-gray-900 dark:text-white"))">@perf.Performance</span>
                                            </td>
                                            <td class="px-2 sm:px-4 py-2 text-right align-middle">
                                                <div class="flex items-center justify-end gap-1 flex-wrap">
                                                    @if (perf.IsSchoolRecord) { <span class="chip-sr" title="School Record">SR</span> }
                                                    @if (perf.IsPersonalBest) { <span class="chip-pr" title="Personal Best">PR</span> }
                                                    @if (perf.IsSeasonBest && !perf.IsPersonalBest) { <span class="chip-rank" title="Season Best">SB</span> }
                                                    @if (perf.AllTimeRank.HasValue && perf.AllTimeRank <= 10)
                                                    {
                                                        <span class="chip-rank" title="All-Time Top 10">#@perf.AllTimeRank</span>
                                                    }
                                                    @foreach (var placing in perf.Placings)
                                                    {
                                                        <span class="chip-place" title="@(placing.OpponentSchoolName != null ? $"vs. {placing.OpponentSchoolName}" : "Place")">
                                                            @placing.PlaceLabel@(placing.OpponentSchoolName != null ? $" vs. {placing.OpponentSchoolName}" : "")
                                                        </span>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    }
                </div>
            }
        </div>
    }

</div>
